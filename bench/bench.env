# ---------------------------------------------------------------------------
# pipen benchmark harness - configuration
#
# This is the ONLY place the harness reads paths and protocol sizes from.
# It is read at startup by bench_config.py (Python drivers/analysis) and by
# run_all.sh / setup_env.sh (bash).  Every key has a sane default, so the
# harness runs unmodified on a different machine.
#
# Override without editing this file:
#   * command line:   bash run_all.sh /tmp/run1          (sets OUT_ROOT)
#   * environment:    BENCH_NPROC=8 bash run_all.sh /tmp/run1
#                     BENCH_RUNINFO=0 bash run_all.sh /tmp/run1
#   * another file:   BENCH_ENV=/path/to/my.env bash run_all.sh /tmp/run1
# An empty value means "use the default for this machine" (see each comment).
# ---------------------------------------------------------------------------

# -- locations --------------------------------------------------------------
# Harness directory (the directory holding the drivers and this file).
# Empty = auto-detected from the location of bench_config.py.
ROOT=
# Python interpreter that has pipen installed; the pipen arms run the pipeline
# scripts with it.  Empty = the interpreter running the driver (sys.executable).
PY=
# Snakemake executable for the snakemake arms.  Empty = first `snakemake` on PATH.
SMK=
# Where run artefacts are written: records JSON, logs/, markers/, summaries.
# Empty = <ROOT>/out
OUT_ROOT=
# Scratch space for pipeline workdirs, generated inputs and the per-job marker
# logs that measure the job count (OUT_ROOT gets an archived copy of them).
# Empty = <OUT_ROOT>/work .  Keep this on a LOCAL disk: the archived run showed
# that a 9p/network mount (e.g. /mnt/f) both slows the DAG down and silently
# drops lines from concurrently appended marker logs (measured: 29 of 42 lines
# lost on 9p, none on ext4).
WORK_ROOT=

# -- machine / protocol -----------------------------------------------------
# Concurrency used for the "as many cores as possible" arms.  Empty = os.cpu_count().
NPROC=
# Repeats of every scaling point (the archived run used 3; its tables quote medians).
REPS=3
# N (fan-out width) values for the scaling arm, comma separated.
SCALING_NS=1,10,100,500
# N for the concurrency arm, and the fork/cores levels to sweep (MAX = NPROC).
CONC_N=20
CONC_FORKS=1,2,4,MAX
# Caching arm sizes: invalidation-scope experiment (3N+1 jobs) and cold/warm timing.
CACHE_SCOPE_N=8
CACHE_TIMING_N=100
CACHE_TIMING_REPS=1
# Sleep per job in seconds: the "useful work" every job does.
SLEEP=0.05

# -- self-describing job directories ---------------------------------------
# 1 = every pipen job directory carries job.runinfo.session (interpreter and
#     package versions), job.runinfo.device and job.runinfo.time via the
#     pipen-runinfo plugin.  run_all.sh installs pipen-runinfo into PY if it is
#     missing.  Set to 0 to measure without the plugin (as the archived run did).
RUNINFO=1
# 1 = run_all.sh may `pip install pipen-runinfo`; 0 = require it, never install.
RUNINFO_INSTALL=1

# -- environment creation (used only by setup_env.sh) -----------------------
# Base interpreter used to create the virtualenvs.
BASE_PYTHON=python3
# What to install into the pipen venv (space separated; use "-e /path/to/pipen"
# for a source checkout, as the archived run did).
PIPEN_INSTALL=pipen==1.2.3
# The plugin that makes every job directory self-describing.
PIPEN_RUNINFO_PKG=pipen-runinfo
# What to install into the snakemake venv.
SMK_INSTALL=snakemake==9.27.0

# -- optional provenance / publishing --------------------------------------
# pipen source checkout, used only for git metadata in environment.json.
# Empty = skip the git fields (they become null).
PIPEN_REPO=
# If set, summary.json / derived_numbers.json are ALSO copied here after a run.
# Empty (default) = write only inside OUT_ROOT, never touch an archived raw/ dir.
ARCHIVE=
# Log level handed to the pipen pipelines.
LOGLEVEL=info
